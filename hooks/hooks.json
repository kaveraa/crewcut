{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/crewcut.js\" session",
            "timeout": 5,
            "statusMessage": "crewcut: loading the ruleset"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/crewcut.js\" subagent",
            "timeout": 5,
            "statusMessage": "crewcut: briefing the subagent"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/crewcut.js\" prompt",
            "timeout": 5,
            "statusMessage": "crewcut: checking the level"
          }
        ]
      }
    ]
  }
}
